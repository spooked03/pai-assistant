# Copy to .env (in the directory you run `assistant` from) or export these.

# Model: any PydanticAI model string
PAI_MODEL=anthropic:claude-sonnet-5-5
# PAI_MODEL=openai:gpt-5.1
# PAI_MODEL=google-gla:gemini-2.5-pro
# PAI_MODEL=ollama:qwen3:14b   (also set OLLAMA_BASE_URL=http://localhost:11434/v1)

# Provider API key(s) for the model you pick
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

PAI_USER_NAME=YourName
PAI_TIMEZONE=Europe/Amsterdam

# Optional switches
# PAI_ENABLE_GOOGLE=true
# PAI_ENABLE_SHELL=true
# PAI_ENABLE_WEB=true
# PAI_HISTORY_TURNS=30
