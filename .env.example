# Copy to ~/.config/pai-assistant/.env (works from any directory) or to ./.env,
# or export these as environment variables.

# --- Option 1: PydanticAI model string ("<provider>:<model>") --------------
# Default: DeepSeek V4.1 Flash 1017 via OpenRouter
PAI_MODEL=openrouter:deepseek/deepseek-v4.1-flash-1017
OPENROUTER_API_KEY=
# OPENROUTER_APP_TITLE=pai-assistant   (attribution shown on openrouter.ai)
#
# PAI_MODEL=anthropic:claude-sonnet-5-5    + ANTHROPIC_API_KEY=
# PAI_MODEL=openai:gpt-5.1                 + OPENAI_API_KEY=
# PAI_MODEL=google-gla:gemini-2.5-pro      + GEMINI_API_KEY=

# --- Option 2: any OpenAI-compatible endpoint --------------------------------
# When PAI_BASE_URL is set, PAI_MODEL is the endpoint's own model name (no prefix).
# PAI_BASE_URL=https://api.deepseek.com
# PAI_MODEL=deepseek-flash
# PAI_API_KEY=
#
# Local examples (no key needed):
# PAI_BASE_URL=http://localhost:11434/v1   PAI_MODEL=qwen3:14b      (Ollama)
# PAI_BASE_URL=http://localhost:8000/v1    PAI_MODEL=<served model> (vLLM / llama.cpp / LM Studio)

PAI_USER_NAME=YourName
PAI_TIMEZONE=Europe/Amsterdam

# Optional switches
# PAI_ENABLE_GOOGLE=true
# PAI_ENABLE_SHELL=true
# PAI_ENABLE_WEB=true
# PAI_HISTORY_TURNS=30
